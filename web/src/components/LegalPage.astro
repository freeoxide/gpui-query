---
// Presentational legal-page wrapper (ported from components/legal-page.tsx).
// Markup/classes are identical; only the framework changed (React -> Astro).
export interface Props {
  title: string;
  description: string;
  updatedAt: string;
}
const { title, description, updatedAt } = Astro.props;
---
<div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
  <header class="border-b border-border pb-8">
    <p class="font-mono text-xs font-medium uppercase tracking-[0.18em] text-primary">
      Website legal
    </p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-foreground sm:text-5xl">{title}</h1>
    <p class="mt-5 max-w-2xl text-base leading-7 text-muted-foreground">{description}</p>
    <p class="mt-6 font-mono text-xs font-medium uppercase tracking-[0.16em] text-muted-foreground">
      Last updated <span class="ml-2 font-sans text-sm normal-case tracking-normal text-foreground"
        >{updatedAt}</span
      >
    </p>
  </header>

  <article class="mt-8 border border-border bg-card shadow-sm">
    <div class="border-b border-border bg-muted/30 px-5 py-5 sm:px-8">
      <p class="text-sm leading-6 text-muted-foreground">
        These pages are intentionally plain-language and scoped to this website. They do not change
        the license terms for the gpui-query source code.
      </p>
    </div>
    <div class="divide-y divide-border">
      <slot />
    </div>
  </article>
</div>
