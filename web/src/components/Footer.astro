---
// Static footer (ported from components/footer.tsx). Converted to Astro per
// the migration plan's "second pass: convert footer to Astro". TanStack
// <Link> replaced with plain <a>; "Built with TanStack Start" -> "Astro".
const docLinks = [
  { label: "Getting Started", href: "/docs/getting-started/installation" },
  { label: "Core Concepts", href: "/docs/" },
  { label: "API", href: "/docs/api/queries" },
] as const;
const year = `2024–${new Date().getFullYear()}`;
---
<footer class="border-t bg-card">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    {/* Logo + tagline */}
    <div class="mb-10 flex items-center gap-3">
      <img src="/logo.svg" alt="gpui-query logo" width="32" height="32" class="h-8 w-8" />
      <span class="text-lg font-bold tracking-tight text-foreground">gpui-query</span>
    </div>

    {/* 3-column grid */}
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
      <div>
        <h3 class="mb-4 text-xs font-semibold uppercase tracking-wider text-primary">
          Documentation
        </h3>
        <ul class="space-y-2.5">
          {docLinks.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="text-sm text-muted-foreground transition-colors duration-200 hover:text-primary"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="mb-4 text-xs font-semibold uppercase tracking-wider text-primary">
          Community
        </h3>
        <ul class="space-y-2.5">
          <li>
            <a
              href="https://github.com/freeoxide/gpui-query"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm text-muted-foreground transition-colors duration-200 hover:text-primary"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                <path
                  d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17 4.6 18 4.9 18 4.9c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"
                ></path>
              </svg>
              GitHub
            </a>
          </li>
          <li>
            <a
              href="/blog"
              class="inline-block text-sm text-muted-foreground transition-colors duration-200 hover:text-primary"
            >
              Blog
            </a>
          </li>
          <li>
            <a
              href="/changelog"
              class="inline-block text-sm text-muted-foreground transition-colors duration-200 hover:text-primary"
            >
              Changelog
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="mb-4 text-xs font-semibold uppercase tracking-wider text-primary">Legal</h3>
        <ul class="space-y-2.5">
          <li>
            <a
              href="/privacy"
              class="inline-block text-sm text-muted-foreground transition-colors duration-200 hover:text-primary"
            >
              Privacy Policy
            </a>
          </li>
          <li>
            <a
              href="/terms"
              class="inline-block text-sm text-muted-foreground transition-colors duration-200 hover:text-primary"
            >
              Terms of Service
            </a>
          </li>
          <li>
            <a
              href="https://github.com/freeoxide/gpui-query/blob/master/LICENSE"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block text-sm text-muted-foreground transition-colors duration-200 hover:text-primary"
            >
              MIT License
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom bar */}
    <div class="mt-10 border-t pt-6 text-center">
      <p class="text-xs text-muted-foreground">
        &copy; {year} hmziq. Built with
        <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary transition-colors duration-200 hover:text-primary/80">Astro</a
        >.
      </p>
    </div>
  </div>
</footer>
