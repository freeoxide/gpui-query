---
type CalloutType = "info" | "warning" | "tip" | "note";

interface Props {
  type?: CalloutType;
}

const { type = "note" } = Astro.props;

const calloutConfig: Record<CalloutType, { icon: string; className: string }> = {
  info: {
    icon: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>',
    className:
      "border-blue-500/50 bg-blue-500/10 text-blue-700 dark:text-blue-400",
  },
  warning: {
    icon: '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
    className:
      "border-yellow-500/50 bg-yellow-500/10 text-yellow-700 dark:text-yellow-400",
  },
  tip: {
    icon: '<path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/>',
    className:
      "border-green-500/50 bg-green-500/10 text-green-700 dark:text-green-400",
  },
  note: {
    icon: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
    className: "border-muted-foreground/50 bg-muted text-foreground",
  },
};

const config = calloutConfig[type] ?? calloutConfig.note;
const role = type === "warning" ? "alert" : "note";
---

<div class:list={["my-4 flex gap-3 rounded-lg border p-4", config.className]} role={role}>
  <div class="mt-0.5 shrink-0">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="h-5 w-5"
      aria-hidden="true"
      set:html={config.icon}
    />
  </div>
  <div class="min-w-0 flex-1 text-sm">
    <slot />
  </div>
</div>
