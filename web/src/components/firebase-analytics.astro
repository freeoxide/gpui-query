---
// Firebase Analytics — vanilla port of firebase-analytics.tsx. Renders nothing;
// a deferred <script> monkey-patches history.{push,replace}State and listens for
// popstate to log a page view after every navigation (lazy-imports the firebase
// helper so the SDK isn't pulled into the entry chunk).
---

<script>
  function setupFirebaseAnalytics() {
    const logAfterNavigation = () => {
      window.setTimeout(() => {
        void import("#/lib/firebase").then(
          ({ logFirebasePageView }) => logFirebasePageView(),
        );
      }, 0);
    };

    const originalPushState = window.history.pushState;
    const originalReplaceState = window.history.replaceState;

    window.history.pushState = function pushState(
      this: History,
      ...args: Parameters<typeof originalPushState>
    ) {
      const result = originalPushState.apply(this, args);
      logAfterNavigation();
      return result;
    };

    window.history.replaceState = function replaceState(
      this: History,
      ...args: Parameters<typeof originalReplaceState>
    ) {
      const result = originalReplaceState.apply(this, args);
      logAfterNavigation();
      return result;
    };

    window.addEventListener("popstate", logAfterNavigation);
    logAfterNavigation();
  }

  const run = () => setupFirebaseAnalytics();
  if ("requestIdleCallback" in window) {
    (window as any).requestIdleCallback(run, { timeout: 2000 });
  } else {
    window.setTimeout(run, 1000);
  }
</script>
