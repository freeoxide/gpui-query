---
import { tintRust } from "./rust-tint";

interface Props {
  code: string;
  lineNumbers?: boolean;
  class?: string;
}

const { code, lineNumbers = false, class: cls = "" } = Astro.props;

// Build the <code> inner HTML as a single string. Astro (unlike React)
// preserves literal template whitespace, and inside a <pre> the indented,
// multi-line JSX below would render as big blank gaps between code lines.
// Assembling the markup here and injecting via set:html avoids that entirely.
const lines = code.split("\n");
const inner = lines
  .map((line, i) => {
    const ln = lineNumbers
      ? `<span class="mr-4 inline-block w-5 text-right text-muted-foreground/40 select-none">${i + 1}</span>`
      : "";
    return `<span class="block min-h-[1.5rem]">${ln}${tintRust(line)}</span>`;
  })
  .join("");
---
<pre class={`overflow-x-auto p-5 font-mono text-[13px] leading-6 text-foreground/85 ${cls}`}><code set:html={inner} /></pre>
