---
import Icon from "../Icon.astro";
import SchematicPanel from "./v1/SchematicPanel.astro";
import HookTabs from "./v1/HookTabs.astro";
import CacheDeck from "./v2/CacheDeck.astro";
import BeforeAfter from "./v2/BeforeAfter.astro";
import AnnotatedFigure from "./v3/AnnotatedFigure.astro";
import ArchitectureSection from "./architecture-section.astro";
import ComparisonSection from "./comparison-section.astro";
import FeatureShowcase from "./feature-showcase.astro";
import CommandLine from "./decor/CommandLine.astro";
import VersionSwitcher from "./version-switcher.astro";
---

<div class="flex flex-col">
  {/* HeroV4 */}
  <section class="relative overflow-hidden" data-hero>
    <div aria-hidden="true" class="v1-grid-base pointer-events-none absolute inset-0 -z-10"></div>
    <div data-hero-glow aria-hidden="true" class="v1-grid-glow pointer-events-none absolute inset-0 -z-10"></div>

    <div class="mx-auto max-w-7xl px-4 pt-16 pb-16 sm:px-6 sm:pt-24 sm:pb-20 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14">
        <div>
          <div class="inline-flex items-center gap-2.5 border border-primary/25 bg-primary/5 px-3 py-1.5 font-mono text-[11px] tracking-[0.2em] uppercase text-primary">
            <span class="h-1.5 w-1.5 bg-primary"></span>
            async state for GPUI
          </div>

          <h1 class="font-display mt-8 text-5xl font-bold tracking-tight text-foreground sm:text-6xl">
            Cache, fetch,
            <br />
            render. <span class="text-primary">One path.</span>
          </h1>

          <p class="mt-6 max-w-lg text-lg leading-relaxed text-muted-foreground">
            gpui-query wires network, cache, retry, and revalidation into one small API for GPUI
            applications.
          </p>

          <div class="mt-10 flex flex-col gap-4 sm:flex-row">
            <a href="/docs/" class="btn" data-size="lg">
              Get Started
              <Icon name="arrow-right" size={16} class="ml-1" />
            </a>
            <a
              href="https://github.com/freeoxide/gpui-query"
              target="_blank"
              rel="noopener noreferrer"
              class="btn"
              data-variant="outline"
              data-size="lg"
            >
              <Icon name="github-logo" size={18} class="mr-1.5" />
              GitHub
            </a>
          </div>
        </div>

        <SchematicPanel />
      </div>
    </div>
  </section>

  <FeatureShowcase />

  {/* QueryClientLiveSection */}
  <section class="border-t border-border py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
        QueryClient, live
      </h2>
      <p class="mt-4 max-w-2xl text-muted-foreground">
        Entries age, go stale, revalidate, and log each transition. Use the row controls to force
        the lifecycle.
      </p>
      <div class="mt-10">
        <CacheDeck />
      </div>
    </div>
  </section>

  <HookTabs />

  <BeforeAfter />

  <ComparisonSection />

  <AnnotatedFigure />

  <ArchitectureSection />

  {/* CtaV4 */}
  <section class="relative overflow-hidden border-t border-border py-24 sm:py-28">
    <div
      aria-hidden="true"
      class="v1-grid-base pointer-events-none absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_70%_70%_at_50%_100%,black,transparent)]"
    ></div>
    <div class="mx-auto max-w-2xl px-4 text-center sm:px-6">
      <h2 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">
        Ship the lifecycle once
      </h2>
      <p class="mx-auto mt-4 max-w-md text-muted-foreground">
        Add the crate, keep your views small, and let QueryClient own the async state machine.
      </p>
      <div class="mt-10 flex justify-center">
        <CommandLine command="cargo add gpui-query" />
      </div>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/docs/" class="btn" data-size="lg">
          Get Started
          <Icon name="arrow-right" size={16} class="ml-1" />
        </a>
        <a
          href="https://github.com/freeoxide/gpui-query"
          target="_blank"
          rel="noopener noreferrer"
          class="btn"
          data-variant="outline"
          data-size="lg"
        >
          <Icon name="github-logo" size={18} class="mr-1.5" />
          Star on GitHub
        </a>
      </div>
    </div>
  </section>

  <VersionSwitcher current="v4" />
</div>

<script>
  const hero = document.querySelector("[data-hero]");
  const glow = document.querySelector("[data-hero-glow]");
  if (hero && glow) {
    hero.addEventListener("mousemove", (e) => {
      const rect = hero.getBoundingClientRect();
      glow.style.setProperty("--mx", `${e.clientX - rect.left}px`);
      glow.style.setProperty("--my", `${e.clientY - rect.top}px`);
    });
  }
</script>
