---
const positions = [
  "-top-1 -left-1",
  "-top-1 -right-1",
  "-bottom-1 -left-1",
  "-bottom-1 -right-1",
];
---

{positions.map((pos) => (
  <svg
    aria-hidden="true"
    width="9"
    height="9"
    viewBox="0 0 9 9"
    class={`pointer-events-none absolute ${pos} text-primary/60`}
  >
    <path d="M4.5 0v9M0 4.5h9" stroke="currentColor" stroke-width="1" />
  </svg>
))}
