---
// Navbar — vanilla port of navbar.tsx (+ mobile-nav.tsx folded in as a Basecoat
// Drawer). Static markup; a small inline script wires the scroll shadow, the
// mobile drawer open/close, and hands search opening off to SearchDialog
// (which binds [data-search-open] and the ⌘K shortcut itself).
import ThemeToggle from "./theme-toggle.astro";

const navLinks: { href: string; label: string }[] = [
  { href: "/docs/", label: "Docs" },
  { href: "/blog", label: "Blog" },
  { href: "/faq", label: "FAQ" },
];
---

<header
  data-navbar
  class="sticky top-0 z-40 w-full border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60 transition-shadow duration-300"
>
  <div class="mx-auto flex h-14 max-w-7xl items-center px-4 sm:px-6 lg:px-8">
    <a href="/" class="mr-6 flex items-center space-x-2">
      <img
        src="/logo.svg"
        alt="gpui-query logo"
        width="28"
        height="28"
        class="h-7 w-7"
      />
      <span class="text-xl font-bold">gpui-query</span>
    </a>

    <nav
      class="hidden flex-1 items-center gap-6 md:flex"
      aria-label="Main navigation"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class={
              "text-sm font-medium text-foreground/70 transition-colors hover:text-foreground " +
              (link.href.startsWith("/docs")
                ? ""
                : "relative after:absolute after:bottom-[-2px] after:left-0 after:h-0.5 after:w-0 after:bg-primary after:transition-all after:duration-200 hover:after:w-full")
            }
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex flex-1 items-center justify-end gap-2 md:flex">
      <button
        type="button"
        class="btn hidden h-8 gap-2 text-muted-foreground md:flex"
        data-variant="outline"
        data-size="sm"
        data-search-open
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-3.5"
          aria-hidden="true"
          ><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"
          ></circle></svg
        >
        <span class="text-xs">Search</span>
        <kbd
          class="pointer-events-none ml-1 rounded border bg-muted px-1 py-0.5 text-[10px]"
          >⌘K</kbd
        >
      </button>

      <ThemeToggle />

      <a
        href="https://github.com/freeoxide/gpui-query"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub repository"
        class="btn hidden md:inline-flex"
        data-variant="ghost"
        data-size="icon"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-5"
          aria-hidden="true"
          ><path
            d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
          ></path></svg
        >
      </a>

      <button
        type="button"
        class="btn md:hidden"
        data-variant="ghost"
        data-size="icon"
        aria-label="Open navigation menu"
        data-drawer-open="mobile-nav"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-5"
          aria-hidden="true"
          ><path d="M4 5h16"></path><path d="M4 12h16"></path><path d="M4 19h16"
          ></path></svg
        >
      </button>
    </div>
  </div>
</header>

{/* Mobile navigation — Basecoat Drawer (native <dialog> + drawer.js slide) */}
<dialog
  id="mobile-nav"
  class="drawer"
  data-side="left"
  aria-label="Navigation"
  onclick="if(event.target===this)this.close()"
>
  <div>
    <header><h2 class="text-lg font-semibold">Navigation</h2></header>
    <section>
      <nav class="flex flex-col gap-4 pt-4" aria-label="Mobile navigation">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              data-drawer-close
              class="text-lg font-medium text-muted-foreground transition-colors hover:text-foreground"
            >
              {link.label}
            </a>
          ))
        }
        <a
          href="https://github.com/freeoxide/gpui-query"
          target="_blank"
          rel="noopener noreferrer"
          data-drawer-close
          class="flex items-center gap-2 text-lg font-medium text-muted-foreground transition-colors hover:text-foreground"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-5"
            aria-hidden="true"
            ><path
              d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
            ></path></svg
          >
          GitHub
        </a>
      </nav>
    </section>
  </div>
</dialog>

<script>
  // Scroll shadow.
  const navbar = document.querySelector<HTMLElement>("[data-navbar]");
  if (navbar) {
    const onScroll = () =>
      navbar.classList.toggle("shadow-sm", window.scrollY > 10);
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  // Drawers: open via [data-drawer-open="id"], close on any [data-drawer-close] link.
  document
    .querySelectorAll<HTMLButtonElement>("[data-drawer-open]")
    .forEach((btn) =>
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-drawer-open");
        if (id) document.getElementById(id)?.showModal();
      }),
    );
  document.querySelectorAll<HTMLElement>("[data-drawer-close]").forEach((el) =>
    el.addEventListener("click", () => {
      (el.closest("dialog") as HTMLDialogElement | null)?.close();
    }),
  );
</script>
