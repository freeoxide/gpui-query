---
// Presentational legal-section wrapper (ported from components/legal-page.tsx).
export interface Props {
  title: string;
}
const { title } = Astro.props;
---
<section class="px-5 py-7 sm:px-8 sm:py-8">
  <h2 class="text-lg font-semibold tracking-tight text-foreground sm:text-xl">{title}</h2>
  <div
    class="mt-3 space-y-4 text-[15px] leading-7 text-muted-foreground [&_a]:font-medium [&_a]:text-primary [&_a]:underline [&_a]:decoration-primary/30 [&_a]:underline-offset-4 [&_a:hover]:decoration-primary [&_code]:border [&_code]:border-border [&_code]:bg-muted [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.9em] [&_code]:text-foreground [&_strong]:font-semibold [&_strong]:text-foreground"
  >
    <slot />
  </div>
</section>
