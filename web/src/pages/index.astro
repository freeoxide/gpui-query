---
import BaseLayout from "../layouts/BaseLayout.astro";
import { LandingV4 } from "../components/landing/v4";
import { softwareSourceCode } from "../lib/seo";

// V4 won the landing preview bake-off and renders as the homepage. The whole
// landing tree is one React island (state, timers, mouse tracking, scroll
// reveal via src/hooks/use-scroll-reveal.ts) — hydrated eagerly with client:load
// since the hero is above the fold. The /v1–/v4 preview routes stay disabled.
const title = "gpui-query — Async State Management for GPUI";
const description =
  "Zero-boilerplate async state management for GPUI. Caching, retry, cooperative cancellation, and persistence for the Zed editor's framework.";
const jsonLd = softwareSourceCode({
  name: "gpui-query",
  description: "Zero-boilerplate async state management for GPUI",
  programmingLanguage: "Rust",
  codeRepository: "https://github.com/freeoxide/gpui-query",
  url: "https://gpui-query.freeoxide.com",
  license: "MIT",
});
---
<BaseLayout title={title} description={description} canonicalPath="/" jsonLd={jsonLd}>
  <LandingV4 client:load />
</BaseLayout>
